{
  "name": "owebstudio/kirby-tui-image-editor",
  "description": "Full-featured photo image editor using canvas for Kirby. It is really easy, and it comes with great filters.",
  "type": "kirby-plugin",
  "version": "1.3.0",
  "license": "MIT",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby3",
    "kirby4",
    "kirby-image-editor",
    "image-editor"
  ],
  "homepage": "https://owebstudio.com",
  "support": {
    "email": "support@owebstudio.com"
  },
  "authors": [
    {
      "name": "oweb studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "require": {
    "php": "^7.4|^8.0",
    "getkirby/composer-installer": "^1.2"
  },
  "extra": {
    "installer-name": "kirby-tui-image-editor"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
