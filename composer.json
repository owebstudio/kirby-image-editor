{
  "name": "owebstudio/kirby-image-editor",
  "description": "Crop, rotate, flip, resize and filter images right in the Kirby Panel.",
  "type": "kirby-plugin",
  "license": "proprietary",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby4",
    "kirby-image-editor",
    "image-editor",
    "crop"
  ],
  "homepage": "https://github.com/owebstudio/kirby-image-editor",
  "support": {
    "email": "support@owebstudio.com",
    "issues": "https://github.com/owebstudio/kirby-image-editor/issues",
    "source": "https://github.com/owebstudio/kirby-image-editor"
  },
  "authors": [
    {
      "name": "oweb studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://github.com/owebstudio"
    }
  ],
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "require": {
    "php": "^8.1",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "owebstudio/kirby-license": "^1.0.1"
  },
  "extra": {
    "installer-name": "kirby-image-editor",
    "kirby": {
      "compatible": "^4.0 || ^5.0"
    }
  },
  "prefer-stable": true
}
